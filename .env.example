# Eddington fork configuration for the account owner's personal Google account
# (Gmail/Drive/Calendar). Copy this file to .env, fill in the real values at the
# bottom, and never commit the real .env (already gitignored) — see CLAUDE.md's
# "Hard rule". LAN hostnames/IPs and the OAuth client ID/secret are deliberately not
# filled in here even as "non-secret" examples — see the private eddington-shared repo
# (not this public fork) for the real deployed values.

# -------------------------------------------------------------------
# Server (streamable HTTP, matching the other self-hosted MCP servers in this project)
# -------------------------------------------------------------------
# Pick a port that doesn't collide with this project's other self-hosted MCP servers —
# see the private eddington-shared repo's mcp/servers.md for the current port map.
WORKSPACE_MCP_PORT=8488
# Production: your MCP host's own LAN address, e.g. http://192.0.2.10 (RFC 5737
# example address — substitute your real host).
# Local bootstrap/re-auth run (see CLAUDE.md): http://localhost — must match whichever
# GOOGLE_OAUTH_REDIRECT_URI below you're using for that run.
WORKSPACE_MCP_BASE_URI=http://localhost
# Legacy streamable-http (no MCP_ENABLE_OAUTH21 here) has no per-request MCP-level
# auth, so main.py's resolve_bind_host_for_transport() defaults to 127.0.0.1 unless
# told otherwise. Only set this to 0.0.0.0 if you trust your LAN as the perimeter —
# that's this project's existing trust model for its other self-hosted MCP servers,
# but it is a deliberate choice, not a default to copy blindly.
WORKSPACE_MCP_HOST=0.0.0.0
# Upstream's own docker-compose.yml sets this to /app/store_creds, but that's only
# honored via its separate GOOGLE_MCP_CREDENTIALS_DIR env var — without it, credentials
# land at ~/.google_workspace_mcp/credentials (the container user's home), outside any
# mounted volume, and get lost on recreation. Set explicitly to match this fork's
# docker-compose.yaml volume mount.
GOOGLE_MCP_CREDENTIALS_DIR=/app/store_creds

# -------------------------------------------------------------------
# Scope: Gmail/Drive/Calendar only (decided 2026-10-06 — see the shared note's
# "Related: same idea for Google" section). Not Docs/Sheets/Slides/Forms/Chat/Tasks/
# Contacts/AppsScript/Search — this fork supports those too, but they were never part
# of the scoped decision. WORKSPACE_MCP_PERMISSIONS below (service:level pairs)
# implicitly selects which services get registered — don't also set
# WORKSPACE_MCP_TOOLS, main.py treats the two as mutually exclusive and exits(1) if
# both are set.
#
# Permission levels (decided 2026-10-06, accepting the 7-day Testing-mode refresh-
# token expiry rather than scoping down to avoid Google's Restricted-scope
# classification — see the shared note's Decisions section for the full reasoning):
#   - gmail:send   — cumulative through readonly+organize(labels,modify)+drafts+send.
#     Matches the "read + send, no permanent delete" pattern used for Outlook/AP —
#     gmail.modify allows trashing, not permanent delete (that needs the separate,
#     unused mail.google.com full-access scope, which this fork never requests).
#   - drive:readonly — no concrete Drive write use case was decided yet; Drive only
#     has readonly/full tiers (no middle ground), so readonly is the narrower default.
#   - calendar:full — the vision note's "calendar interface" idea needs real
#     read/write scheduling; calendar has no readonly-with-write option either, and
#     calendar data is lower-stakes/more recoverable than email or files.
# -------------------------------------------------------------------
WORKSPACE_MCP_PERMISSIONS=gmail:send drive:readonly calendar:full

# -------------------------------------------------------------------
# Google Cloud project: a dedicated project, separate from any project used by other
# apps' own OAuth clients — least-privilege separation, matching this project's
# dedicated-account pattern elsewhere (agent/mcp-service). OAuth consent screen:
# External, Testing (see shared note — Production would need Google's formal
# verification for the Restricted scopes above, not worth it for a personal
# single-user tool).
#
# GOOGLE_OAUTH_CLIENT_ID/_SECRET below come from that project's Cloud Console, Clients
# tab — real values live in the password manager and the private eddington-shared
# repo's deployment notes, not here or in your committed .env.
# -------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_VALUE_FROM_PASSWORD_MANAGER
# Must exactly match one of the redirect URIs registered on the OAuth client in Cloud
# Console. Google rejects any redirect URI whose host isn't localhost/a loopback
# address or a public-TLD domain — a bare LAN IP (e.g. http://192.0.2.10/...) will be
# refused at client-creation time, so a production deployment's own address generally
# can't be used as a working redirect target. See CLAUDE.md's "The actual auth flow"
# section for the local-bootstrap-then-copy-token workaround this project uses.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth2callback

# -------------------------------------------------------------------
# THE ONE SECRET — DO NOT COMMIT A REAL VALUE
# -------------------------------------------------------------------
# The OAuth client's secret (from Google Cloud Console, Clients tab). This is a
# freshly-minted app credential, not a pre-existing account password — still: store
# the real value in your password manager, then paste it into your local, gitignored
# .env only.
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_VALUE_FROM_PASSWORD_MANAGER
